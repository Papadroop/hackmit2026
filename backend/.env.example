# Copy to backend/.env (gitignored). The API reads it at startup; so does `python -m auditor.llm check`.
ANTHROPIC_API_KEY=sk-ant-...
# Claude defaults for the pipeline stages (auditor/llm.py). Sonnet at high effort for now;
# set AUDITOR_MODEL=claude-opus-5 to step up, AUDITOR_EFFORT=xhigh or max for harder work.
AUDITOR_MODEL=claude-sonnet-5
AUDITOR_EFFORT=high
# Claim extraction (step 11) reads at medium effort: same recall as high on the Shell page, 3x faster.
# AUDITOR_EXTRACT_EFFORT=medium
# The linguistic evaluator (step 12) also runs at medium effort, in parallel batches of 9 claims plus one
# call for the page as a whole: first mark after about 12 s on the Shell page, done in about 40 s.
# AUDITOR_LANGUAGE_EFFORT=medium
# AUDITOR_LANGUAGE_BATCH=9
# The substantiation evaluator (step 13) matches claims to the knowledge stores at low effort (first item after
# a few seconds) and scores Support in parallel batches at medium effort. The stores live in knowledge/.
# AUDITOR_SUBSTANTIATE_MATCH_EFFORT=low
# AUDITOR_SUBSTANTIATE_EFFORT=medium
# AUDITOR_SUBSTANTIATE_BATCH=9
# AUDITOR_KNOWLEDGE_DIR=../knowledge
# External verification (step 14) searches the web in parallel calls of AUDITOR_VERIFY_BATCH claims,
# each allowed AUDITOR_VERIFY_SEARCHES searches and AUDITOR_VERIFY_FETCHES fetches, then recomputes the
# numbers and scores Support and Materiality in calls of AUDITOR_VERIFY_SCORE_BATCH claims.
# AUDITOR_VERIFY_RETRIEVE_EFFORT=medium
# AUDITOR_VERIFY_COMPUTE_EFFORT=medium
# AUDITOR_VERIFY_EFFORT=medium
# AUDITOR_VERIFY_BATCH=6
# AUDITOR_VERIFY_SCORE_BATCH=9
# AUDITOR_VERIFY_SEARCHES=6
# AUDITOR_VERIFY_FETCHES=6
# The search and fetch tools: the direct pair by default. `filtering` uses the newer
# web_search_20260209 / web_fetch_20260209, which run the search inside a code sandbox and, measured
# on the Ørsted page, took 228 s to return nothing quotable against the direct pair's 30 s.
# AUDITOR_WEB_TOOLS=filtering
# Self-consistency (step 15) searches the company's own filings and pages, then reads the Wayback
# Machine's captures of this very page: AUDITOR_CONSISTENCY_SNAPSHOTS captures at least
# AUDITOR_CONSISTENCY_MIN_AGE_DAYS old, each truncated to AUDITOR_CONSISTENCY_MAX_CHARS.
# AUDITOR_CONSISTENCY_ELSEWHERE_EFFORT=medium
# AUDITOR_CONSISTENCY_ARCHIVE_EFFORT=medium
# AUDITOR_CONSISTENCY_EFFORT=medium
# AUDITOR_CONSISTENCY_BATCH=8
# AUDITOR_CONSISTENCY_SCORE_BATCH=9
# AUDITOR_CONSISTENCY_SEARCHES=6
# AUDITOR_CONSISTENCY_FETCHES=6
# AUDITOR_CONSISTENCY_SNAPSHOTS=3
# AUDITOR_CONSISTENCY_MIN_AGE_DAYS=30
# AUDITOR_CONSISTENCY_MAX_CHARS=60000
# The omissions stage (step 16) places the page's industry against the materiality reference at low
# effort, then reads what the page covers at medium. The reference is knowledge/materiality.json.
# AUDITOR_OMISSIONS_PLACE_EFFORT=low
# AUDITOR_OMISSIONS_EFFORT=medium
# The verdict layer (step 17) argues each batch of AUDITOR_VERDICT_BATCH claims between a prosecutor
# and a defence at AUDITOR_VERDICT_ARGUE_EFFORT, then judges them at AUDITOR_VERDICT_EFFORT.
# AUDITOR_VERDICT_SAMPLES above 1 runs the judge repeatedly and feeds how far the judges agree with
# each other into the verdict's confidence; it costs a call per sample per batch.
# AUDITOR_VERDICT_ARGUE_EFFORT=medium
# AUDITOR_VERDICT_EFFORT=high
# AUDITOR_VERDICT_BATCH=6
# AUDITOR_VERDICT_SAMPLES=1
# The summary (step 18) is arithmetic; AUDITOR_SUMMARY_POWER is how far the mean leans toward the
# worst of the page (1 would be a plain mean, which lets true footnotes bury a false headline).
# Claude is called once, for the issue and credit titles and the narrative.
# AUDITOR_SUMMARY_POWER=3
# AUDITOR_SUMMARY_ISSUES=5
# AUDITOR_SUMMARY_CREDIT=4
# AUDITOR_SUMMARY_DRIVERS=6
# AUDITOR_SUMMARY_EFFORT=medium
# Calibration (step 19) scores the precedent set leave-one-out. The threshold is where a claim
# is called misleading; the report's sweep shows what every other operating point would cost.
# AUDITOR_CALIBRATION_THRESHOLD=0.5
# AUDITOR_CALIBRATION_BINS=5
# AUDITOR_CALIBRATION_CONCURRENCY=4
# AUDITOR_CALIBRATION_FILE=data/calibration.json
